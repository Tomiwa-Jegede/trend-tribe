generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   Int             @id @default(autoincrement())
  slug                 String?         @unique
  email                String          @unique
  username             String          @unique
  password             String
  fullName             String
  school               String
  bio                  String?
  avatar               String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  isVerified           Boolean         @default(false)
  otpCode              String?
  otpExpiresAt         DateTime?
  resetToken           String?         @unique
  resetTokenExpiresAt  DateTime?
  matricNumber         String?         @unique
  avatarPublicId       String?
  whatsapp             String?
  role                 Role            @default(USER)
  aiUsesRemaining      Int             @default(0)
  numberViewsRemaining Int             @default(0)
  tokenBalance         Float           @default(5)
  gigBalance           Int             @default(0) // kobo, separate from marketplace tokenBalance, buyable, Naira display
  gigAccountNumber     String?         @unique // 10 digits like 8091234567
  firstServiceAt       DateTime?
  serviceTrialEndsAt   DateTime?
  marketingOptIn       Boolean         @default(true)
  unsubscribeToken     String          @unique @default(cuid())
  tokenPurchases       TokenPurchase[]
  gigPurchases         GigTokenPurchase[]
  gigsPosted           Gig[]           @relation("GigPoster")
  gigsClaimed          Gig[]           @relation("GigClaimer")
  gigWithdrawals       GigWithdrawal[]
  gigTransfersSent     GigTransfer[]     @relation("GigTransferFrom")
  gigTransfersReceived GigTransfer[]     @relation("GigTransferTo")
  serviceBookingsAsBooker ServiceBooking[] @relation("ServiceBooker")
  serviceBookingsAsProvider ServiceBooking[] @relation("ServiceProvider")
  listings             Listing[]
  reports              Report[]
  favorites            Favorite[]
  notifications        Notification[]
  contactViews         ContactView[]
  sentMessages         Message[] @relation("SentMessages")
  receivedMessages     Message[] @relation("ReceivedMessages")
  pushSubscriptions    PushSubscription[]
  pwaInstalls          PWAInstall[]

  @@map("users")
}

model PendingRegistration {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  password     String
  fullName     String
  school       String
  matricNumber String?
  bio          String?
  otpCode      String
  otpExpiresAt DateTime
  createdAt    DateTime @default(now())
  role         Role     @default(BUYER)
  whatsapp     String?

  @@map("pending_registrations")
}

model TokenPurchase {
  id                       String   @id @default(cuid())
  userId                   Int
  reference                String   @unique // our tx_ref sent to Flutterwave
  flutterwaveTransactionId String?  @unique // Flutterwave's numeric transaction ID (received after redirect)
  quantity                 Int      // display tokens purchased (not raw units)
  amount                   Int      // amount in kobo/subunit
  status                   String   @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model FrederickSession {
  id        String   @id @default(cuid())
  sessionId String
  cost      Int
  createdAt DateTime @default(now())
  userId    Int

  @@unique([userId, sessionId])
}

model Listing {
  id             Int       @id @default(autoincrement())
  slug           String?   @unique
  title          String
  description    String
  price          Decimal   @db.Decimal(10, 2)
  category       Category
  subcategory    Subcategory?
  condition      Condition
  images         String[]  @default([])
  location       String?
  isAvailable    Boolean   @default(true)
  soldAt         DateTime?
  archivedAt     DateTime?
  boostedAt      DateTime?
  boostedUntil   DateTime?
  boostTier      Int?        @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sellerId       Int
  imagePublicIds String[]  @default([])
  coverPosition  Json?     @default("{\"x\": 50, \"y\": 50}")
  editCount      Int       @default(0)
  contactViews   Int       @default(0)
  seller         User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reports        Report[]
  favorites      Favorite[]
  notifications  Notification[]
  contactViewLogs ContactView[]
  messages       Message[]
  serviceBookings ServiceBooking[]

  @@map("listings")
}

model Report {
  id         Int          @id @default(autoincrement())
  reason     ReportReason
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  listingId  Int
  reporterId Int
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([listingId, reporterId])
  @@index([status])
  @@map("reports")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  listingId Int
  userId    Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId])
  @@map("favorites")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int // recipient (seller)
  actorId   Int? // who favorited
  listingId Int?
  type      String // FAVORITE
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([listingId])
  @@map("notifications")
}

model ContactView {
  id        Int      @id @default(autoincrement())
  listingId Int
  viewerId  Int
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([viewerId])
  @@map("contact_views")
}

model Message {
  id          Int      @id @default(autoincrement())
  subject     String?
  body        String
  senderId    Int
  recipientId Int
  listingId   Int?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@index([listingId])
  @@map("messages")
}

model SearchLog {
  id        Int      @id @default(autoincrement())
  query     String
  category  String?
  userId    Int?
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("search_logs")
}

model AiFreeUsage {
  id         Int      @id @default(autoincrement())
  identifier String   // userId or ip — each gets own 10/20 per day, not shared
  date       String   // YYYY-MM-DD
  count      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, date])
  @@map("ai_free_usages")
}

model GeminiLog {
  id        Int      @id @default(autoincrement())
  date      String   @unique // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gemini_logs")
}

model PushSubscription {
  id             Int      @id @default(autoincrement())
  userId         Int?
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model PWAInstall {
  id          Int      @id @default(autoincrement())
  userId      Int?
  platform    String? // android | ios | windows | mac | unknown
  displayMode String? // standalone | browser | minimal-ui
  userAgent   String?
  source      String? // appinstalled | standalone_launch | manual
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([platform])
  @@map("pwa_installs")
}

model SiteConfig {
  id              Int      @id @default(1)
  whatsappMembers Int      @default(63)
  updatedAt       DateTime @updatedAt

  @@map("site_config")
}

model Gig {
  id          Int      @id @default(autoincrement())
  description String
  whatsapp    String   // per-gig WhatsApp, not profile
  amount      Int      // kobo, Naira display = amount/100
  escrowAmount Int     // same as amount at creation, held
  timerHours  Int      @default(24) // how long gig stays open
  status      String   @default("OPEN") // OPEN | CLAIMED | COMPLETED | EXPIRED | CANCELLED | DISPUTED
  posterId    Int
  claimerId   Int?
  claimedAt   DateTime?
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  poster      User     @relation("GigPoster", fields: [posterId], references: [id], onDelete: Cascade)
  claimer     User?    @relation("GigClaimer", fields: [claimerId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([posterId])
  @@index([claimerId])
  @@map("gigs")
}

model GigTokenPurchase {
  id                       String   @id @default(cuid())
  userId                   Int
  reference                String   @unique // gt_ prefix
  flutterwaveTransactionId String?  @unique
  amount                   Int      // kobo
  status                   String   @default("PENDING")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@map("gig_token_purchases")
}

model GigWithdrawal {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int      // kobo
  whatsapp  String
  status    String   @default("PENDING") // PENDING | COMPLETED | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@map("gig_withdrawals")
}

model GigTransfer {
  id          Int      @id @default(autoincrement())
  fromUserId  Int
  toUserId    Int
  amount      Int      // kobo, without fee
  fee         Int      // kobo, 5000 (50) or 10000 (100)
  reference   String   @unique @default(cuid())
  status      String   @default("SUCCESS") // SUCCESS | FAILED
  createdAt   DateTime @default(now())
  fromUser    User     @relation("GigTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User     @relation("GigTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@map("gig_transfers")
}

model ServiceBooking {
  id          Int      @id @default(autoincrement())
  listingId   Int
  bookerId    Int
  providerId  Int
  amount      Int      // kobo, service price at booking time
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | EXPIRED | COMPLETED | DISPUTED
  expiresAt   DateTime // 1h from booking
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booker      User     @relation("ServiceBooker", fields: [bookerId], references: [id], onDelete: Cascade)
  provider    User     @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([bookerId])
  @@index([providerId, status])
  @@map("service_bookings")
}

enum Role {
  USER
  ADMIN
  BUYER
  SELLER
}

enum ReportReason {
  SCAM
  FAKE_ITEM
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  IGNORED
}

enum Category {
  ACCESSORIES
  FASHION
  BEAUTY_AND_PERSONAL_CARE
  SNACKS
  OTHERS
  GADGETS
  SERVICES
}

enum Subcategory {
  MENS_FASHION
  FEMALE_FASHION
  UNISEX_FASHION
  JERSEY
  TIES
  SKIN_CARE
  FRAGRANCE
  HAIR_AND_WIGS
  PHONE_ACCESSORIES
  JEWELRY
  OTHERS
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}
